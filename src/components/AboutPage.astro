---
import { config } from "@/config";
import { getPastEvents, isHostedCommunityEventType } from "@/utils/events";
import type { CollectionEntry } from "astro:content";
import AboutMission from "@/components/about/AboutMission.astro";
import AboutEventTypes from "@/components/about/AboutEventTypes.astro";
import PageToc from "@/components/PageToc.astro";
import SectionHeading from "@/components/SectionHeading.astro";

type EventEntry = CollectionEntry<"events">;

interface Ambassador {
  name: string;
  nameAr?: string;
  role: string;
  roleAr: string;
  city: string;
  cityAr: string;
  photo?: string;
  description?: string;
  descriptionAr?: string;
  linkedin?: string;
  status?: "active" | "retired";
}

const tocItems = [
  { id: "mission", labelEn: "Mission", labelAr: "الرسالة" },
  { id: "event-types", labelEn: "Past Events", labelAr: "الفعاليات السابقة" },
  { id: "chapters", labelEn: "Chapters", labelAr: "الفروع" },
  { id: "team", labelEn: "Team History", labelAr: "سجل الفريق" },
];

const ambassadors = config.ambassadors as readonly Ambassador[];
const past = (await getPastEvents()).filter((event: EventEntry) => isHostedCommunityEventType(event.data.type));
const chapters = [
  {
    city: "Riyadh",
    cityAr: "الرياض",
    established: "2025",
    description: "The former flagship chapter hosted Cursor Saudi meetups, workshops, and build sessions in Riyadh.",
    descriptionAr: "استضاف الفرع الرئيسي السابق لقاءات وورش وجلسات بناء كيرسر السعودية في الرياض.",
  },
  {
    city: "Khobar",
    cityAr: "الخبر",
    established: "2025",
    description: "The former Eastern Province chapter connected builders across Khobar, Dammam, and Dhahran.",
    descriptionAr: "ربط فرع المنطقة الشرقية السابق المبدعين في الخبر والدمام والظهران.",
  },
];
---

<section id="about">
  <div class="max-w-7xl mx-auto px-6 md:px-10 py-12 md:py-20">
    <div class="mb-10 rounded-2xl border border-red-500/25 bg-red-500/10 p-6 md:p-8" role="status">
      <p class="text-xs font-mono uppercase tracking-widest text-red-300 mb-2">
        <span class="lang-en">Archive status</span><span class="lang-ar">حالة الأرشيف</span>
      </p>
      <h1 class="text-2xl md:text-3xl font-semibold text-white mb-3">
        <span class="lang-en">Cursor Saudi is offline</span><span class="lang-ar">كيرسر السعودية غير متصلة</span>
      </h1>
      <p class="text-sm md:text-base text-red-100/80 leading-relaxed">
        <span class="lang-en">The community and every chapter are offline indefinitely. This page preserves the history of work completed before activity ended.</span>
        <span class="lang-ar">المجتمع وجميع الفروع غير متصلة إلى أجل غير مسمى. تحفظ هذه الصفحة تاريخ الأعمال المنجزة قبل توقف النشاط.</span>
      </p>
    </div>

    <PageToc items={tocItems} />
    <AboutMission />
    <AboutEventTypes />

    <div class="mb-24">
      <div class="text-center mb-12">
        <span class="text-xs font-mono text-[#999999] uppercase tracking-widest">
          <span class="lang-en">Former chapters</span><span class="lang-ar">الفروع السابقة</span>
        </span>
        <SectionHeading id="chapters" class="text-3xl font-semibold text-white mt-3">
          <span class="lang-en">All chapters are offline</span><span class="lang-ar">جميع الفروع غير متصلة</span>
        </SectionHeading>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-stretch max-w-4xl mx-auto">
        {chapters.map((chapter) => {
          const completed = past.filter((event: EventEntry) => event.data.location === chapter.city).length;
          const formerAmbassador = ambassadors.find((person) => person.city === chapter.city);
          const partners = config.partners.filter((partner) => (partner.cities as readonly string[]).includes(chapter.city));
          return (
            <div class="bg-[#171717] border border-red-500/20 rounded-2xl p-8 h-full flex flex-col">
              <div class="flex items-start justify-between gap-4 mb-6">
                <div class="flex items-center gap-3">
                  <span class="w-2.5 h-2.5 rounded-full bg-red-500"></span>
                  <h3 class="text-xl font-semibold text-white">
                    <span class="lang-en">{chapter.city} Chapter</span><span class="lang-ar">فرع {chapter.cityAr}</span>
                  </h3>
                </div>
                <div class="text-end shrink-0">
                  <div class="text-[10px] font-mono text-red-300 border border-red-500/35 bg-red-500/10 rounded px-2 py-0.5">
                    <span class="lang-en">Offline</span><span class="lang-ar">غير متصل</span>
                  </div>
                  <div class="text-[10px] text-[#6E6E6E] mt-1">EST. {chapter.established}</div>
                </div>
              </div>
              <p class="text-sm text-[#999999] leading-relaxed mb-5">
                <span class="lang-en">{chapter.description}</span><span class="lang-ar">{chapter.descriptionAr}</span>
              </p>
              {formerAmbassador && (
                <p class="text-xs text-[#8A8A8A] mb-5">
                  <span class="lang-en">Historical lead: <strong class="text-white/80 font-medium">{formerAmbassador.name}</strong></span>
                  <span class="lang-ar">القائد السابق: <strong class="text-white/80 font-medium">{formerAmbassador.nameAr ?? formerAmbassador.name}</strong></span>
                </p>
              )}
              <div class="border-t border-[#252525] pt-4 mt-auto">
                <div class="text-xl font-bold text-white">{completed}</div>
                <div class="text-[10px] text-[#999999] uppercase tracking-wider">
                  <span class="lang-en">Completed events</span><span class="lang-ar">فعاليات مكتملة</span>
                </div>
              </div>
              {partners.length > 0 && (
                <div class="border-t border-[#252525] pt-4 mt-4">
                  <div class="text-[10px] uppercase tracking-widest text-[#6E6E6E] mb-3">
                    <span class="lang-en">Historical partners</span><span class="lang-ar">الشركاء السابقون</span>
                  </div>
                  <div class="flex flex-wrap gap-2">
                    {partners.map((partner) => <img src={partner.logo} alt={partner.name} class="h-8 w-16 object-contain rounded bg-white/[0.03] p-1" loading="lazy" />)}
                  </div>
                </div>
              )}
            </div>
          );
        })}
      </div>
    </div>

    <div class="mb-16">
      <div class="text-center mb-10">
        <span class="text-xs font-mono text-[#999999] uppercase tracking-widest">
          <span class="lang-en">Historical roster</span><span class="lang-ar">السجل التاريخي</span>
        </span>
        <SectionHeading id="team" class="text-3xl font-semibold text-white mt-3">
          <span class="lang-en">Community leadership history</span><span class="lang-ar">سجل قيادة المجتمع</span>
        </SectionHeading>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-3xl mx-auto">
        {ambassadors.map((person) => (
          <div class="bg-[#171717] border border-[#252525] rounded-2xl p-6 text-center">
            {person.photo && <img src={person.photo} alt={person.name} class="w-24 h-24 rounded-full object-cover border-2 border-[#252525] mx-auto mb-4 opacity-80" loading="lazy" />}
            <div class="text-[10px] font-mono uppercase tracking-widest text-[#8A8A8A] mb-2">
              <span class="lang-en">{person.status === "retired" ? "Retired" : "Historical"} · {person.city}</span>
              <span class="lang-ar">{person.status === "retired" ? "متقاعد" : "سابق"} · {person.cityAr}</span>
            </div>
            <h3 class="text-lg font-semibold text-white mb-2"><span class="lang-en">{person.name}</span><span class="lang-ar">{person.nameAr ?? person.name}</span></h3>
            <p class="text-sm text-[#999999] leading-relaxed mb-4"><span class="lang-en">{person.description}</span><span class="lang-ar">{person.descriptionAr}</span></p>
            {person.linkedin && <a href={person.linkedin} target="_blank" rel="noreferrer" class="text-xs text-[#8A8A8A] hover:text-white transition-colors">LinkedIn</a>}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
